{
 "format": "RFC 8785 (JCS) cases from the mcp-tool-set-digest/1 test vectors",
 "licence": "Apache-2.0 OR MIT",
 "how": "input is JSON text. Parse it as I-JSON and write the RFC 8785 canonical form of the whole value; expected is {canonical, sha256} (sha256 = hex SHA-256 of the UTF-8 bytes of canonical) or {refused, code} when RFC 8785 has no output for the input. implementations holds what each of the three reference implementations answered (python, javascript, go; `--canonical` mode), all equal. equal and differ name pairs whose expected results must match or must not.",
 "refusals": {
  "TSD-NUMBER": "number-without-double: a number literal with no IEEE 754 double (RFC 8785 section 3.2.2.3, I-JSON RFC 7493 section 2.2)",
  "TSD-TEXT": "lone-surrogate: a string holding an unpaired UTF-16 surrogate (RFC 8785 section 3.2.2.2, I-JSON RFC 7493 section 2.1)"
 },
 "source": "vectors.json (each case's id is the vector its input comes from; scripts/jcs_subset.py)",
 "not_covered": "repeated member names (RFC 8785 requires I-JSON, which forbids them; mcp-tool-set-digest keeps the last one, so those vectors are left out) and nesting depth limits.",
 "equal": [
  [
   "numbers-as-written",
   "numbers-canonical"
  ],
  [
   "extras-numbers-as-written",
   "extras-numbers-canonical"
  ],
  [
   "integer-beyond-2-53-odd",
   "integer-beyond-2-53-even"
  ],
  [
   "string-escaped-a",
   "string-raw-a"
  ],
  [
   "order-utf16-escaped",
   "order-utf16-raw"
  ]
 ],
 "differ": [
  [
   "string-nfc",
   "string-nfd"
  ],
  [
   "typical",
   "typical-whitespace"
  ]
 ],
